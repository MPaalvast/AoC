{% extends 'base.html.twig' %}

{% block title %}AoC Menu{% endblock %}

{% block body %}
    <div class="journal-layout">
        <aside class="journal-sidebar">
            <h2 class="brand">AoC</h2>
            <p class="sidebar-subtitle">Opgeloste puzzels</p>

            {% include 'puzzle/_menu.html.twig' with {
                years: years,
                days: days,
                parts: parts,
                dayProgresses: dayProgresses,
                partStatuses: partStatuses,
                selectedYear: selectedYear,
                selectedDay: selectedDay,
                selectedPart: selectedPart
            } %}

            <p class="admin-link">
                <a href="{{ path('aoc_admin_solutions') }}">Ga naar admin-overzicht van registered solvers</a>
            </p>
        </aside>

        <section class="journal-main">
            <span class="heading-tag">Advent of Code · Home</span>
            <h1 class="page-title">Almanac</h1>
            <p class="page-subtitle">Kies links je jaar, dag en part om direct naar de juiste puzzelpagina te gaan.</p>
        </section>
    </div>
{% endblock %}
