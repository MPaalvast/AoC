{% extends 'base.html.twig' %}

{% block title %}Registered Solvers{% endblock %}

{% block body %}
    <span class="heading-tag">Advent of Code · Admin</span>
    <h1 class="page-title">Registered Solvers</h1>
    <p class="page-subtitle">Beheer jaren/dagen en bekijk welke solver parts beschikbaar zijn.</p>

    {% for message in app.flashes('error') %}
        <div class="flash-error">{{ message }}</div>
    {% endfor %}

    <p>
        Add a new class that implements <code>App\Advent\Domain\PuzzleSolver</code> under
        <code>src/Advent/Infrastructure/Solution/YearYYYY/DayXX/PartXSolver.php</code>.
        It will be auto-tagged and available in this list via <code>solutionIndex</code>.
    </p>

    {% for year, days in solutionIndex %}
        <div class="panel">
            <h2>Year {{ year }}</h2>
            {% for day, parts in days %}
                <p>Day {{ '%02d'|format(day) }}: Parts {{ parts|join(', ') }}</p>
            {% endfor %}
        </div>
    {% else %}
        <p>No solutions registered yet.</p>
    {% endfor %}

    <div class="panel">
        <a href="{{ path('aoc_home') }}">Terug naar menu</a>
    </div>
{% endblock %}
