{% extends 'base.html.twig' %}

{% block title %}{{ puzzlePart1.title }}{% endblock %}

{% block body %}
    {% set part1Status = partStatuses[1] ?? 'not_started' %}
    {% set part2Status = partStatuses[2] ?? 'not_started' %}

    {% for message in app.flashes('error') %}
        <div class="flash-error">{{ message }}</div>
    {% endfor %}

    <div class="journal-layout">
        <aside class="journal-sidebar">
            <h2 class="brand">AoC</h2>
            <p class="sidebar-subtitle">Opgeloste puzzels</p>

            {% include 'puzzle/_menu.html.twig' with {
                years: years,
                days: days,
                parts: parts,
                dayProgresses: dayProgresses,
                partStatuses: partStatuses,
                selectedYear: selectedYear,
                selectedDay: selectedDay,
                selectedPart: selectedPart
            } %}

            <p class="admin-link">
                <a href="{{ path('aoc_admin_solutions') }}">Ga naar admin-overzicht van registered solvers</a>
            </p>
        </aside>

        <section class="journal-main">
            <span class="heading-tag">{{ selectedYear }} · Day {{ selectedDay }}</span>
            <h1 class="day-title">{{ puzzlePart1.title }}</h1>
{#            <p class="day-description">Één input voor de dag, die je voor beide parts kunt submitten.</p>#}

            <form
                method="post"
                action="{{ path('aoc_part', {year: selectedYear, day: selectedDay, part: selectedPart}) }}"
            >
                <div class="shared-input">
                    <label for="day-input">Jouw input (gedeeld voor part 1 en part 2)</label>
                    <textarea id="day-input" name="input">{{ input }}</textarea>
                </div>
                <input type="hidden" name="result_1_output" value="{{ results[1] ? results[1].output : '' }}">
                <input type="hidden" name="result_2_output" value="{{ results[2] ? results[2].output : '' }}">

                <div class="parts-grid">
                    <article class="part-card">
                        <h2>Part 1</h2>
                        <div class="part-status">Status: {{ part1Status == 'solved' ? 'Solved' : 'Not started' }}</div>
                        <p>{{ puzzlePart1.description }}</p>
                        <div class="actions">
                            <button
                                type="submit"
                                formaction="{{ path('aoc_part', {year: selectedYear, day: selectedDay, part: 1}) }}"
                                data-turbo-frame="part-result-1"
                            >Submit part 1</button>
                            {% if part1Status != 'solved' %}
                                <button type="submit" formaction="{{ path('aoc_mark_solved', {year: selectedYear, day: selectedDay, part: 1}) }}" data-turbo="false">Mark solved</button>
                            {% else %}
                                <button type="submit" formaction="{{ path('aoc_mark_open', {year: selectedYear, day: selectedDay, part: 1}) }}" data-turbo="false">Mark open</button>
                            {% endif %}
                        </div>

                        {{ include('puzzle/_part_result.html.twig', {
                            frameId: 'part-result-1',
                            result: results[1],
                            emptyText: 'Nog geen resultaat voor part 1.'
                        }) }}
                    </article>

                    <article class="part-card">
                        <h2>Part 2</h2>
                        <div class="part-status">Status: {{ part2Status == 'solved' ? 'Solved' : 'Not started' }}</div>
                        <p>{{ puzzlePart2.description }}</p>
                        <div class="actions">
                            <button
                                type="submit"
                                formaction="{{ path('aoc_part', {year: selectedYear, day: selectedDay, part: 2}) }}"
                                data-turbo-frame="part-result-2"
                            >Submit part 2</button>
                            {% if part2Status != 'solved' %}
                                <button type="submit" formaction="{{ path('aoc_mark_solved', {year: selectedYear, day: selectedDay, part: 2}) }}" data-turbo="false">Mark solved</button>
                            {% else %}
                                <button type="submit" formaction="{{ path('aoc_mark_open', {year: selectedYear, day: selectedDay, part: 2}) }}" data-turbo="false">Mark open</button>
                            {% endif %}
                        </div>

                        {{ include('puzzle/_part_result.html.twig', {
                            frameId: 'part-result-2',
                            result: results[2],
                            emptyText: 'Nog geen resultaat voor part 2.'
                        }) }}
                    </article>
                </div>
            </form>
        </section>
    </div>
{% endblock %}
