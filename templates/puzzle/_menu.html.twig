<h3>Jaar kiezen</h3>
<ul class="menu-list">
    {% for year in years %}
        <li class="menu-item {{ selectedYear == year ? 'is-selected' : '' }}">
            <a href="{{ path('aoc_year', {year: year}) }}">{{ year }}</a>
        </li>
    {% else %}
        <li>Er zijn nog geen jaren beschikbaar.</li>
    {% endfor %}
</ul>

{% if selectedYear %}
    <h3>Dag kiezen</h3>
    <ul class="menu-list">
        {% for day in days %}
            <li class="menu-item {{ selectedDay == day ? 'is-selected' : '' }}">
                {% set p1 = dayProgresses[day][1] ?? 'not_started' %}
                {% set p2 = dayProgresses[day][2] ?? 'not_started' %}
                <a href="{{ path('aoc_part', {year: selectedYear, day: day, part: 1}) }}">
                    Day {{ '%02d'|format(day) }}
                    <span class="progress-badge {{ p1 == 'solved' ? 'is-solved' : 'is-not-started' }}">P1 {{ p1 == 'solved' ? 'Solved' : 'Not started' }}</span>
                    <span class="progress-badge {{ p2 == 'solved' ? 'is-solved' : 'is-not-started' }}">P2 {{ p2 == 'solved' ? 'Solved' : 'Not started' }}</span>
                </a>
            </li>
        {% else %}
            <li>Geen dagen beschikbaar voor dit jaar.</li>
        {% endfor %}
    </ul>
{% endif %}
